# Variables de entorno para producción en Vercel
# Agrégalas en: vercel.com → tu proyecto → Settings → Environment Variables

# Groq AI (obligatorio para análisis)
# Obtén tu key gratis en: https://console.groq.com
GROQ_API_KEY=gsk_...

# Telegram Bot (opcional — para notificaciones)
# Crear bot: busca @BotFather en Telegram → /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
# Obtener chat ID: busca @userinfobot en Telegram → /start
TELEGRAM_CHAT_ID=123456789

# Cron secret (opcional — protege el endpoint /api/daily-scan de accesos externos)
CRON_SECRET=una_clave_secreta_aleatoria_aqui
